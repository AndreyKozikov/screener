[Unit]
Description=Bonds Screener Backend API Service (Gunicorn + Uvicorn)
After=network.target bondsscreener-db.service redis-server.service
Wants=bondsscreener-db.service redis-server.service

[Service]
Type=simple
User={{DEPLOY_USER}}
Group={{DEPLOY_USER}}
WorkingDirectory={{APP_DIR}}/backend
Environment="PATH={{APP_DIR}}/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH={{APP_DIR}}/backend:{{APP_DIR}}"
Environment="NO_PROXY=localhost,127.0.0.1,::1"
Environment="no_proxy=localhost,127.0.0.1,::1"
EnvironmentFile=-{{APP_DIR}}/backend/.env
ExecStart={{APP_DIR}}/.venv/bin/gunicorn -c config/gunicorn_config.py main:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

