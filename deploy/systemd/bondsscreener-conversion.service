[Unit]
Description=Bonds Screener Conversion Service
After=network.target bondsscreener-db.service
Wants=bondsscreener-db.service

[Service]
Type=simple
User={{DEPLOY_USER}}
Group={{DEPLOY_USER}}
WorkingDirectory={{APP_DIR}}
Environment="PATH={{APP_DIR}}/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH={{APP_DIR}}"
Environment="NO_PROXY=localhost,127.0.0.1,::1"
Environment="no_proxy=localhost,127.0.0.1,::1"
EnvironmentFile=-{{APP_DIR}}/conversion_service/.env
ExecStart={{APP_DIR}}/.venv/bin/python -m conversion_service.run_conv_service
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

